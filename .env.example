# Optional: override where the AI food-photo scanner sends captured photos.
# Defaults to the relative path '/api/analyze-food' if not set.
VITE_FOOD_AI_ENDPOINT=/api/analyze-food

# Set this on your SERVER/BACKEND deployment only (Vercel/Netlify/Supabase
# project env vars) — never add a VITE_ prefix to it, or it will be bundled
# into the client and exposed to anyone using the app.
# ANTHROPIC_API_KEY=sk-ant-...

